{
    "name": "renocms/cms",
    "description": "Reno CMS",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Reno CMS Team",
            "email": "contacts@renocms.ru"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Reno\\Cms\\": "src/",
            "Reno\\Cms\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reno\\Cms\\RenoServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

